RUNSPEC
TITLE
   flow_ph_co2store: CO2 injector (RESV, WINJTEMP) and brine producer (BHP), reference depth at the connections
DIMENS
   40 1 1 /
EQLDIMS
/
TABDIMS
/
WELLDIMS
 2 1 1 2 /
ENTHALPY
CO2STORE
OIL
GAS
WATER
METRIC
START
   1 'JAN' 2020 /
UNIFOUT
GRID
INIT
DX
   40*5 /
DY
   40*10 /
DZ
   40*10 /
TOPS
   40*1500 /
PORO
   40*0.2 /
PERMX
   40*1000 /
PERMY
   40*1000 /
PERMZ
   40*1000 /
HEATCR
   40*2000 /
HEATCRT
   40*0 /
THCONR
   40*150 /
PROPS
-- Sw krw pcow
SWFN
 0.2 0.0 0
 0.6 0.25 0
 1.0 1.0 0 /
-- Sg krg pcgo
SGFN
 0.0 0.0 0
 0.4 0.2 0
 0.8 0.7 0 /
-- So krow krog (the oil phase is liquid CO2)
SOF3
 0.0 0.0 0.0
 0.4 0.1 0.1
 0.8 0.8 0.8 /
ROCK
 150 1.0e-3 /
SOLUTION
PRESSURE
 40*150 /
TEMPI
 40*45 /
SWAT
 40*1 /
SUMMARY
BPR
 1 1 1 /
 10 1 1 /
 20 1 1 /
 40 1 1 /
/
BTEMP
 1 1 1 /
 10 1 1 /
 20 1 1 /
 40 1 1 /
/
BSGAS
 1 1 1 /
 10 1 1 /
 20 1 1 /
/
BSWAT
 1 1 1 /
 10 1 1 /
 20 1 1 /
/
SCHEDULE
RPTRST
  'BASIC=2' 'ALLPROPS' /
-- the reference depth is the depth of the connections (cell centre at 1505 m): a wellbore of a millimetre
WELSPECS
 'INJ' 'G' 1  1 1505 'GAS' /
 'PRO' 'G' 40 1 1505 'WATER' /
/
COMPDAT
 'INJ' 1  1 1 1 'OPEN' 1* 1* 0.2 /
 'PRO' 40 1 1 1 'OPEN' 1* 1* 0.2 /
/
-- 6.45 m3/day of CO2 at 45 C and the pressure of the connection: about 5 tonnes/day
WCONINJE
 'INJ' 'GAS' 'OPEN' 'RESV' 1* 6.45 /
/
WINJTEMP
 'INJ' 1* 45 /
/
WCONPROD
 'PRO' 'OPEN' 'BHP' 5* 148 /
/
TSTEP
 30*1 /
END
